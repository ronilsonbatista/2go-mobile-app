#include? "Pods/Target Support Files/Pods-Runner/Pods-Runner.debug.xcconfig"
#include "Generated.xcconfig"

// Simulator-only: skip Xcode native CodeSign (absolute /usr/bin/codesign fails on
// macOS 15+/26 provenance xattrs). Frameworks are signed via tools/bin shim during
// Flutter assemble; app is deep-signed by tools/scripts/ios_sim_resign.sh.
// Device/Archive (iphoneos) keep normal signing + entitlements.
CODE_SIGNING_ALLOWED[sdk=iphonesimulator*] = NO
CODE_SIGNING_REQUIRED[sdk=iphonesimulator*] = NO
