#!/bin/bash
# LOCAL SIMULATOR HELPER ONLY — never use for device, archive, or App Store.
#
# Intercepts `codesign` when PATH is prepended by tools/scripts/flutter_ios_sim.sh
# (opt-in via TWIGO_ALLOW_IOS_SIM_CODESIGN_WORKAROUND=1).
#
# Strips macOS provenance / Finder xattrs that break Flutter's ad-hoc Simulator
# codesign on macOS 15+/26, then execs the real /usr/bin/codesign.
#
# Safety invariants:
# - This file is NEVER on the global PATH.
# - project.pbxproj must NOT prepend tools/bin (device/archive must use /usr/bin/codesign).
# - Does not change signing identity, entitlements, or provisioning.
set -euo pipefail
echo "[2go-codesign-shim] $*" >> /tmp/2go-codesign-shim.log
for arg in "$@"; do
  if [[ -e "$arg" ]]; then
    parent=$(dirname "$arg")
    /usr/bin/xattr -cr "$parent" 2>/dev/null || true
    /usr/bin/xattr -c "$arg" 2>/dev/null || true
    /usr/bin/xattr -d com.apple.provenance "$arg" 2>/dev/null || true
  fi
done
exec /usr/bin/codesign "$@"
